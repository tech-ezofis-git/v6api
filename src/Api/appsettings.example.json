{
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_POSTGRES_HOST;Port=5432;Database=ezofis_catalog_new;Username=YOUR_USER;Password=YOUR_PASSWORD;Pooling=true;Maximum Pool Size=20;Minimum Pool Size=0;Timeout=15;Command Timeout=30",
    "Redis": ""
  },
  "Catalog": {
    "MaxPoolSize": 20
  },
  "EzofisAuth": {
    "SigningKey": "YOUR_SIGNING_KEY_AT_LEAST_32_CHARS",
    "Issuer": "Ezofis",
    "Audience": "Ezofis"
  },
  "TenantDatabase": {
    "NamePrefix": "ezofis_Tenant",
    "MaxPoolSize": 5
  },
  "Diagnostics": {
    "ShowDetailedErrors": false
  },
  "PathBase": "/V6API",
  "Swagger": {
    "Enabled": true
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "Branding": {
    "EncryptionKey": "Ezofis.Branding.FixedSecret.Key.ChangeInProd!"
  },
  "Hangfire": {
    "RunServerInApi": false,
    "ApiWorkerCount": 1,
    "WorkerCount": 20,
    "MaxPoolSize": 5,
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30
  },
  "EmailIngest": {
    "HangfireEnabled": false,
    "HangfireCron": "*/5 * * * *",
    "MinimumPollIntervalSeconds": 30,
    "TenantDiscoveryMinutes": 30
  },
  "Workflow": {
    "PdfGeneration": {
      "Enabled": true,
      "ServiceUrl": "https://cloud.ezofis.com/api/pdf/generate",
      "TimeoutSeconds": 120
    }
  },
  "Agents": {
    "ChatUrl": "https://cloud.ezofis.com/chat"
  },
  "Dashboard": {
    "Enabled": true,
    "TimeoutSeconds": 120
  },
  "ApAgent": {
    "Enabled": true,
    "TimeoutMinutes": 30,
    "ApiBaseUrl": "http://localhost/V6API/api/workflows",
    "IncludePilotAuthInPayload": true,
    "DefaultSkills": [
      "extract_invoice",
      "po_match",
      "duplicate_detect",
      "backorder_detect",
      "finalize_decision",
      "workflow_move_next"
    ]
  },
  "TenantPilotUser": {
    "Enabled": true,
    "Email": "pilot@ezofis.com",
    "Password": "Ezofis@123",
    "DisplayName": "AP Agent Pilot",
    "Role": "TenantUser"
  },
  "TenantDefaultCredit": {
    "Enabled": true,
    "InitialCredit": 1000,
    "CreditType": "Standard",
    "SubscriptionType": "Trial",
    "Status": "Active",
    "Remarks": "Default allocation on tenant signup",
    "ValidDays": 0
  },
  "EzofisBlobStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net",
    "ContainerPrefix": "ezts"
  },
  "RepositoryShare": {
    "FrontendBaseUrl": "https://demoapp.ezofis.com",
    "SignInPath": "/sign-in",
    "DefaultExpiryDays": 30,
    "EmailSubject": "A document was shared with you"
  },
  "RepositorySignRequest": {
    "FrontendBaseUrl": "https://demoapp.ezofis.com",
    "SignRequestPath": "/sign-request",
    "DefaultExpiryDays": 14,
    "EmailSubjectPrefix": "Please review and sign",
    "SupportEmail": "support@ezofis.com"
  },
  "RepositoryPythonAssistant": {
    "Enabled": true,
    "SearchIntent": "global_search",
    "ChatbotIntent": "chatbot",
    "TimeoutSeconds": 120
  },
  "FormMasterFileImport": {
    "PythonServiceUrl": "https://cloud.ezofis.com/api/ezDataImport"
  },
  "WorkflowMoveNotifications": {
    "Enabled": true,
    "Category": "workflow"
  },
  "ActivityLog": {
    "Enabled": true,
    "LogUnauthenticated401": true,
    "ExcludedPathPrefixes": [ "/api/activity-logs" ],
    "PublicPathPrefixes": [ "/api/signup", "/api/Signup", "/api/tenant/checkAuthenticate", "/api/tenant/validateOTP", "/api/connector/oauth/callback", "/api/branding", "/api/portal-json" ],
    "MaxQueryStringLength": 1024,
    "MaxUserAgentLength": 512
  },
  "EventLog": {
    "Enabled": true,
    "LogAuthLoginUnauthenticated": true,
    "ExcludedPathPrefixes": [ "/api/event-logs", "/api/activity-logs" ],
    "PublicPathPrefixes": [ "/api/signup", "/api/Signup", "/api/tenant/checkAuthenticate", "/api/tenant/validateOTP", "/api/connector/oauth/callback", "/api/branding", "/api/portal-json" ]
  },
  "Jira": {
    "Enabled": false,
    "UseProxy": true,
    "ProxyBaseUrl": "http://127.0.0.1:5055",
    "BaseUrl": "https://ezofis.atlassian.net",
    "Email": "support@ezofis.com",
    "ApiToken": "",
    "ProjectKey": "SSD",
    "IssueType": "Task"
  },
  "ConnectorOAuth": {
    "StateSigningKey": "",
    "StateTtlMinutes": 15,
    "RefreshSkewMinutes": 5,
    "DefaultSuccessRedirectUrl": "https://cloud.ezofis.com/"
  }
}
