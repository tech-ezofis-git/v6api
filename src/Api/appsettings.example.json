{
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_POSTGRES_HOST;Port=5432;Database=ezofis_catalog_new;Username=YOUR_USER;Password=YOUR_PASSWORD;Pooling=true;Command Timeout=0",
    "Redis": ""
  },
  "EzofisAuth": {
    "SigningKey": "YOUR_SIGNING_KEY_AT_LEAST_32_CHARS",
    "Issuer": "Ezofis",
    "Audience": "Ezofis"
  },
  "TenantDatabase": {
    "NamePrefix": "ezofis_Tenant"
  },
  "Diagnostics": {
    "ShowDetailedErrors": false
  },
  "PathBase": "/V6API",
  "Swagger": {
    "Enabled": true
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "Hangfire": {
    "RunServerInApi": true,
    "ApiWorkerCount": 5,
    "WorkerCount": 10
  },
  "EmailIngest": {
    "HangfireEnabled": true,
    "HangfireCron": "*/5 * * * *",
    "TenantDiscoveryMinutes": 30
  },
  "ApAgent": {
    "Enabled": true,
    "PythonServiceUrl": "http://localhost:8001/api/ap-agent/run",
    "ApiBaseUrl": "http://localhost/V6API/api/workflows",
    "TimeoutMinutes": 30
  },
  "ApDashboard": {
    "Insights": {
      "Enabled": true,
      "ApiUrl": "http://localhost:8091/api/v1/insights",
      "TimeoutSeconds": 60
    }
  },
  "TenantPilotUser": {
    "Enabled": true,
    "Email": "pilot@ezofis.com",
    "Password": "CHANGE_ME_PILOT_PASSWORD",
    "DisplayName": "AP Agent Pilot",
    "Role": "TenantUser"
  },
  "TenantDefaultCredit": {
    "Enabled": true,
    "InitialCredit": 1000,
    "CreditType": "Standard",
    "SubscriptionType": "Trial",
    "Status": "Active",
    "Remarks": "Default allocation on tenant signup",
    "ValidDays": 0
  },
  "EzofisBlobStorage": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net",
    "ContainerPrefix": "ezts"
  },
  "RepositoryShare": {
    "FrontendBaseUrl": "https://demoapp.ezofis.com",
    "SignInPath": "/sign-in",
    "DefaultExpiryDays": 30,
    "EmailSubject": "A document was shared with you"
  },
  "RepositorySignRequest": {
    "FrontendBaseUrl": "https://demoapp.ezofis.com",
    "SignRequestPath": "/sign-request",
    "DefaultExpiryDays": 14,
    "EmailSubjectPrefix": "Please review and sign",
    "SupportEmail": "support@ezofis.com"
  },
  "FormMasterFileImport": {
    "Enabled": true,
    "UseHangfirePython": true,
    "PythonServiceUrl": "http://localhost:8002/api/master-file/import",
    "QueueBlobEnabled": false,
    "QueueBlobPathPrefix": "ezPackages/MasterExcel",
    "TimeoutMinutes": 30,
    "NotificationCategory": "WORKFLOW"
  },
  "WorkflowMoveNotifications": {
    "Enabled": true,
    "Category": "workflow"
  },
  "Repository": {
    "Ocr": {
      "UploadForOcrApiUrl": "http://localhost:8090/EztGetMetadataforV6",
      "OcrType": "ADVANCED",
      "PageNo": "1",
      "ValidateType": "1"
    },
    "AiSummary": {
      "ApiUrl": "http://localhost:8091/api/v1/summary",
      "TimeoutMinutes": 5,
      "Credit": 1
    }
  },
  "ActivityLog": {
    "Enabled": true,
    "LogUnauthenticated401": true,
    "ExcludedPathPrefixes": [ "/api/activity-logs" ],
    "PublicPathPrefixes": [ "/api/signup", "/api/Signup", "/api/tenant/checkAuthenticate", "/api/tenant/validateOTP", "/api/connector/oauth/callback" ],
    "MaxQueryStringLength": 1024,
    "MaxUserAgentLength": 512
  },
  "EventLog": {
    "Enabled": true,
    "LogAuthLoginUnauthenticated": true,
    "ExcludedPathPrefixes": [ "/api/event-logs", "/api/activity-logs" ],
    "PublicPathPrefixes": [ "/api/signup", "/api/Signup", "/api/tenant/checkAuthenticate", "/api/tenant/validateOTP", "/api/connector/oauth/callback" ]
  },
  "Jira": {
    "Enabled": false,
    "UseProxy": true,
    "ProxyBaseUrl": "http://127.0.0.1:5055",
    "BaseUrl": "https://ezofis.atlassian.net",
    "Email": "support@ezofis.com",
    "ApiToken": "",
    "ProjectKey": "SSD",
    "IssueType": "Task"
  },
  "ConnectorOAuth": {
    "StateSigningKey": "",
    "StateTtlMinutes": 15,
    "RefreshSkewMinutes": 5,
    "DefaultSuccessRedirectUrl": "https://demoapp.ezofis.com/connectors/oauth-complete"
  }
}
